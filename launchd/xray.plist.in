<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>@PREFIX@.xray</string>
  <key>ProgramArguments</key><array><string>@XRAY@</string><string>run</string><string>-config</string><string>@BASE@/xray/config.json</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@BASE@/xray/xray.log</string>
  <key>StandardErrorPath</key><string>@BASE@/xray/xray.log</string>
</dict></plist>
